---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<Base title="Writing" current="/writing" description="Thoughts I decided to commit to Git instead of keeping in my drafts folder.">
  <section class="px-4 pt-14 pb-16 md:px-8 md:pt-20">
    <h1 class="font-display text-5xl md:text-7xl">WRITING</h1>
    <p class="mt-3 max-w-md text-mute">Essays, rants, and the occasional actually-useful thought.</p>

    <div class="mt-10 space-y-5">
      {posts.map((post) => (
        <a href={`/writing/${post.slug}`} class="sticker group block p-5">
          <p class="font-mono text-[10px] text-mute">{post.data.date}</p>
          <h2 class="font-display mt-1 text-2xl group-hover:text-hotpink">{post.data.title}</h2>
          <p class="mt-1 text-sm text-mute">{post.data.summary}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
