---
import Base from '../layouts/Base.astro';

const updated = 'August 2026';
---

<Base title="Now" current="/now" description="What Emperor Pierre is up to right now.">
  <section class="px-4 pt-12 pb-16 md:px-8 md:pt-16">
    <h1 class="font-display text-5xl md:text-7xl">NOW</h1>
    <p class="font-mono mt-2 text-[11px] font-bold text-mute">Updated {updated}</p>

    <div class="mt-10 space-y-10">
      <div class="sticker rotate-1 p-5">
        <p class="font-mono text-[11px] font-bold text-hotpink">BUILDING</p>
        <ul class="mt-2 space-y-1 font-display text-2xl">
          <li>OutsideTonight</li>
          <li>FreeCreditBot</li>
          <li>EmperorPierre</li>
        </ul>
      </div>

      <div class="sticker -rotate-1 p-5">
        <p class="font-mono text-[11px] font-bold text-hotpink">THINKING ABOUT</p>
        <ul class="mt-2 space-y-1 text-ink">
          <li>whether the simulation has a laugh track</li>
          <li>computational sociology</li>
          <li>urban interfaces</li>
          <li>local AI</li>
          <li>privacy-first software</li>
        </ul>
      </div>

      <div class="sticker rotate-1 p-5">
        <p class="font-mono text-[11px] font-bold text-hotpink">LEARNING</p>
        <ul class="mt-2 space-y-1 text-ink">
          <li>Flutter</li>
          <li>distributed systems</li>
          <li>motion systems</li>
          <li>how to end a bit on time</li>
        </ul>
      </div>

      <div class="sticker -rotate-1 p-5">
        <p class="font-mono text-[11px] font-bold text-hotpink">BASED IN</p>
        <p class="mt-2 text-ink">Los Angeles, obviously.</p>
      </div>
    </div>
  </section>
</Base>
