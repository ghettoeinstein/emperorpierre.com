---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('art');
  return items.map((item, i) => ({
    params: { slug: item.slug },
    props: { entry: item, prev: items[i - 1], next: items[i + 1] },
  }));
}

interface Props {
  entry: CollectionEntry<'art'>;
  prev?: CollectionEntry<'art'>;
  next?: CollectionEntry<'art'>;
}

const { entry, prev, next } = Astro.props;
const { Content } = await entry.render();
const { title, year, medium, image, notes } = entry.data;
---

<Base title={title} current="/art" description={notes ?? title}>
  <section class="mx-auto max-w-2xl px-4 py-12 md:px-8">
    <a href="/art" class="font-mono text-[11px] text-chrome hover:text-signal">&larr; ART</a>

    <div class="mt-6 border border-chrome-dim">
      <img src={image} alt={title} class="w-full" />
    </div>

    <h1 class="font-display mt-6 text-3xl">{title.toUpperCase()}</h1>
    <p class="font-mono mt-1 text-[11px] text-chrome">{year}</p>

    <div class="mt-4">
      <p class="font-mono text-[11px] text-chrome">Medium</p>
      <p class="mt-1">{medium}</p>
    </div>

    {notes && (
      <div class="mt-4">
        <p class="font-mono text-[11px] text-chrome">Notes</p>
        <p class="mt-1">{notes}</p>
      </div>
    )}

    <div class="prose-ep mt-6">
      <Content />
    </div>

    <div class="font-mono mt-10 flex justify-between text-[11px] text-chrome">
      {prev ? <a href={`/art/${prev.slug}`} class="hover:text-signal">&larr; {prev.data.title}</a> : <span />}
      {next ? <a href={`/art/${next.slug}`} class="hover:text-signal">{next.data.title} &rarr;</a> : <span />}
    </div>
  </section>
</Base>
