---
import Base from '../layouts/Base.astro';
import LinkCard from '../components/LinkCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const socials = [
  { label: 'Instagram', href: 'https://instagram.com/emperorpierre' },
  { label: 'TikTok', href: 'https://tiktok.com/@emperorpierre' },
  { label: 'X', href: 'https://x.com/emperorpierre' },
  { label: 'GitHub', href: 'https://github.com/ghettoeinstein' },
];
---

<Base title="Emperor Pierre" current="/">
  <section class="px-4 pt-14 pb-10 md:px-8 md:pt-20">
    <p class="font-mono reveal text-[11px] text-signal">EMPEROR PIERRE&trade;</p>
    <h1 class="font-display reveal mt-3 text-6xl leading-[0.9] md:text-8xl">
      EMPEROR<br />PIERRE
    </h1>
    <p class="font-mono mt-4 text-[11px] text-chrome">LOS ANGELES</p>
    <p class="mt-2 max-w-md text-chrome">Engineer / Builder / Artist / Researcher / Internet Citizen</p>

    <div class="mt-8 border border-chrome-dim px-4 py-3">
      <p class="font-mono text-[10px] text-chrome">CURRENT STATUS</p>
      <p class="mt-1 font-display text-xl">building weird useful things.</p>
    </div>
  </section>

  <section class="border-t border-chrome-dim px-4 py-10 md:px-8">
    <p class="font-mono text-[11px] text-chrome">CURRENT OBSESSIONS</p>
    <ul class="mt-3 flex flex-wrap gap-2 font-mono text-[11px]">
      {['OutsideTonight', 'FreeCreditBot', 'local AI', 'computational cities', 'experimental interfaces'].map((tag) => (
        <li class="border border-chrome-dim px-2 py-1 text-chrome">{tag}</li>
      ))}
    </ul>
  </section>

  {projects.length > 0 && (
    <section class="border-t border-chrome-dim px-4 py-10 md:px-8">
      <p class="font-mono text-[11px] text-chrome">FEATURED</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {projects.map((p) => (
          <LinkCard href={`/projects/${p.slug}`} label={p.data.title} meta={p.data.year} external={false} />
        ))}
        <LinkCard href="/lab" label="Latest Experiment" external={false} />
      </div>
    </section>
  )}

  <section class="border-t border-chrome-dim px-4 py-10 md:px-8">
    <p class="font-mono text-[11px] text-chrome">FIND ME</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      {socials.map((s) => <LinkCard href={s.href} label={s.label} />)}
    </div>
  </section>

  <section class="border-t border-chrome-dim px-4 py-10 md:px-8">
    <p class="font-mono text-[11px] text-chrome">EXPLORE</p>
    <div class="mt-4 grid gap-3 sm:grid-cols-2">
      <LinkCard href="/projects" label="Projects" external={false} />
      <LinkCard href="/history" label="History" external={false} />
      <LinkCard href="/art" label="Art" external={false} />
      <LinkCard href="/writing" label="Writing" external={false} />
      <LinkCard href="/lab" label="Lab" external={false} />
      <LinkCard href="/now" label="Now" external={false} />
    </div>
  </section>
</Base>
