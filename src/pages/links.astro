---
import Base from '../layouts/Base.astro';
import LinkCard from '../components/LinkCard.astro';
---

<Base title="Links" current="/links" description="Emperor Pierre — all links.">
  <section class="px-4 pt-14 pb-10 md:px-8 md:pt-20">
    <h1 class="font-display text-4xl">EMPEROR PIERRE</h1>

    <div class="mt-8 space-y-3">
      <LinkCard href="/#featured" label="What I'm Building" external={false} />
      <LinkCard href="https://outsidetonight.com" label="OutsideTonight" />
      <LinkCard href="/history" label="Read My Story" external={false} />
      <LinkCard href="/art" label="My Art" external={false} />
    </div>

    <hr class="my-8 border-chrome-dim" />

    <div class="space-y-3">
      <LinkCard href="https://github.com/ghettoeinstein" label="GitHub" />
      <LinkCard href="https://instagram.com/emperorpierre" label="Instagram" />
      <LinkCard href="https://tiktok.com/@emperorpierre" label="TikTok" />
      <LinkCard href="https://youtube.com/@emperorpierre" label="YouTube" />
      <LinkCard href="https://linkedin.com" label="LinkedIn" />
      <LinkCard href="https://substack.com" label="Substack" />
    </div>

    <hr class="my-8 border-chrome-dim" />

    <p class="font-mono text-[11px] text-chrome">Currently: building from Los Angeles.</p>
  </section>
</Base>
