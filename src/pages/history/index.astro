---
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';
import { getCollection } from 'astro:content';

const entries = (await getCollection('history')).sort((a, b) => a.data.year.localeCompare(b.data.year));
const timeline = entries.map((e) => ({
  href: `/history/${e.slug}`,
  title: e.data.title,
  date: e.data.date,
  tag: e.data.tag,
  summary: e.data.summary,
}));
---

<Base title="History" current="/history" description="A life timeline. Wins, mistakes, and everything between.">
  <section class="px-4 pt-14 pb-16 md:px-8 md:pt-20">
    <h1 class="font-display text-5xl md:text-7xl">HISTORY</h1>
    <p class="mt-3 max-w-md text-chrome">Not an about page. A timeline — including the parts that didn't work.</p>

    <div class="mt-10">
      <Timeline entries={timeline} />
    </div>
  </section>
</Base>
