---
interface Entry {
  href: string;
  title: string;
  date: string;
  tag: string;
  summary: string;
}

interface Props {
  entries: Entry[];
}

const { entries } = Astro.props;

const tagColor: Record<string, string> = {
  milestone: 'text-hotpink',
  win: 'text-grape',
  mistake: 'text-tangerine',
  shift: 'text-sky',
  origin: 'text-hotpink',
};
---

<ol class="relative border-l-4 border-ink pl-6">
  {entries.map((entry) => (
    <li class="relative pb-10 last:pb-0">
      <span class="absolute -left-[31px] top-1.5 h-4 w-4 rounded-full border-[3px] border-ink bg-gold"></span>
      <a href={entry.href} class="group block">
        <div class="font-mono flex flex-wrap items-center gap-x-3 text-[10px] text-mute">
          <span>{entry.date}</span>
          <span>&middot;</span>
          <span class:list={['font-bold', tagColor[entry.tag] ?? 'text-mute']}>{entry.tag.toUpperCase()}</span>
        </div>
        <h3 class="font-display mt-2 text-2xl transition-colors group-hover:text-hotpink">{entry.title}</h3>
        <p class="mt-1 max-w-lg text-sm text-mute">{entry.summary}</p>
      </a>
    </li>
  ))}
</ol>
