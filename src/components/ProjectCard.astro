---
interface Props {
  href: string;
  title: string;
  year: string;
  status: string;
  type: string;
  thesis: string;
}

const { href, title, year, status, type, thesis } = Astro.props;
---

<a href={href} class="group block border-t border-chrome-dim py-8 first:border-t-0">
  <div class="font-mono flex flex-wrap items-center gap-x-3 gap-y-1 text-[10px] text-chrome">
    <span class="text-signal">{status.toUpperCase()}</span>
    <span>&middot;</span>
    <span>{year}</span>
    <span>&middot;</span>
    <span>{type}</span>
  </div>
  <h3 class="font-display mt-3 text-3xl transition-colors group-hover:text-signal md:text-4xl">{title}</h3>
  <p class="mt-2 max-w-lg text-sm text-chrome">{thesis}</p>
  <span class="font-mono mt-4 inline-block text-[11px] text-bone group-hover:text-signal">OPEN PROJECT &rarr;</span>
</a>
