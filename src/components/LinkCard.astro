---
interface Props {
  href: string;
  label: string;
  meta?: string;
  emoji?: string;
  external?: boolean;
}

const { href, label, meta, emoji, external = true } = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class="sticker wiggle group flex items-center justify-between gap-3 px-4 py-4"
>
  <span class="flex items-center gap-2">
    {emoji && <span class="text-xl" aria-hidden="true">{emoji}</span>}
    <span class="font-display text-lg">{label}</span>
  </span>
  <span class="font-mono flex items-center gap-2 text-[10px] text-mute group-hover:text-hotpink">
    {meta && <span>{meta}</span>}
    <span aria-hidden="true">&rarr;</span>
  </span>
</a>
