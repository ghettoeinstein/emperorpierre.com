---
const { current = '' } = Astro.props;

const items = [
  { href: '/', label: 'HOME', glyph: '⌂' },
  { href: '/projects', label: 'WORK', glyph: '◫' },
  { href: '/lab', label: 'LAB', glyph: '◎' },
  { href: '/art', label: 'ART', glyph: '✦' },
  { href: '/history', label: 'MORE', glyph: '≡' },
];
---

<nav
  class="fixed inset-x-0 bottom-0 z-40 border-t border-chrome-dim bg-ink/90 backdrop-blur md:inset-y-0 md:right-auto md:w-20 md:border-t-0 md:border-r"
  aria-label="Primary"
>
  <ul class="mx-auto flex max-w-md items-stretch justify-between px-2 md:mx-0 md:h-full md:max-w-none md:flex-col md:justify-start md:gap-1 md:py-6">
    {items.map((item) => (
      <li class="flex-1 md:flex-none">
        <a
          href={item.href}
          class:list={[
            'flex flex-col items-center gap-1 px-2 py-3 font-mono text-[10px] transition-colors md:py-4',
            current === item.href ? 'text-signal' : 'text-chrome hover:text-bone',
          ]}
        >
          <span class="text-lg leading-none" aria-hidden="true">{item.glyph}</span>
          <span>{item.label}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>
