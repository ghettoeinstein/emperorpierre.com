---
import '../styles/global.css';
import BottomNav from '../components/BottomNav.astro';
import StatusBar from '../components/StatusBar.astro';

interface Props {
  title: string;
  description?: string;
  current?: string;
}

const {
  title,
  description = 'Emperor Pierre — comedy, metaphysics, art, LA culture, tech, and way too many Marvel opinions. All my links, all in one weird place.',
  current = '',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fff6e9" />
    <title>{title} — Emperor Pierre</title>
    <meta property="og:title" content={`${title} — Emperor Pierre`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="min-h-screen pb-24 text-ink md:pb-0 md:pl-24">
    <StatusBar />
    <BottomNav current={current} />
    <main>
      <slot />
    </main>
    <footer class="mt-6 border-t-4 border-ink px-4 py-10 font-mono text-[10px] leading-relaxed text-mute md:pl-24">
      <p class="font-display text-ink">EMPERORPIERRE.COM</p>
      <p class="mt-2">No ads picking my jokes. No algorithm editing my art. Just me, some markdown, and Git.</p>
      <p>Built with Astro. Hosted on GitHub Pages. Made in Los Angeles.</p>
      <p class="mt-2">v0.2.0 — now with 100% more personality</p>
    </footer>
  </body>
</html>
