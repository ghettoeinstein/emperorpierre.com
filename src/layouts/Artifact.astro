---
import Base from './Base.astro';

interface Props {
  title: string;
  eyebrow: string;
  status?: string;
  meta: { label: string; value: string }[];
  description?: string;
  current?: string;
  backHref: string;
  backLabel: string;
}

const { title, eyebrow, status, meta, description, current, backHref, backLabel } = Astro.props;
---

<Base title={title} description={description} current={current}>
  <article class="mx-auto max-w-2xl px-4 py-12 md:px-8">
    <a href={backHref} class="font-mono text-[11px] text-chrome hover:text-signal">&larr; {backLabel}</a>

    <div class="mt-6 flex items-center gap-3">
      <p class="font-mono text-[11px] text-signal">{eyebrow}</p>
      {status && (
        <span class="font-mono rounded-full border border-chrome-dim px-2 py-0.5 text-[10px] text-chrome uppercase">
          {status}
        </span>
      )}
    </div>

    <h1 class="font-display reveal mt-2 text-4xl leading-[0.95] md:text-6xl">{title}</h1>

    <dl class="font-mono mt-8 grid grid-cols-2 gap-x-6 gap-y-3 border-y border-chrome-dim py-6 text-[11px] sm:grid-cols-3">
      {meta.map((m) => (
        <div>
          <dt class="text-chrome">{m.label}</dt>
          <dd class="mt-1 text-bone">{m.value}</dd>
        </div>
      ))}
    </dl>

    <div class="prose-ep mt-10">
      <slot />
    </div>
  </article>
</Base>

<style is:global>
  .prose-ep {
    color: var(--color-bone);
    line-height: 1.75;
  }
  .prose-ep p {
    margin-bottom: 1.25em;
  }
  .prose-ep h2 {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    font-size: 1.5rem;
    margin: 2em 0 0.75em;
  }
  .prose-ep a {
    color: var(--color-signal);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-ep ul,
  .prose-ep ol {
    margin: 0 0 1.25em 1.25em;
  }
  .prose-ep li {
    margin-bottom: 0.4em;
  }
</style>
