---
import Base from './Base.astro';

interface Props {
  title: string;
  eyebrow: string;
  meta: string;
  description?: string;
  current?: string;
  backHref: string;
  backLabel: string;
}

const { title, eyebrow, meta, description, current, backHref, backLabel } = Astro.props;
---

<Base title={title} description={description} current={current}>
  <article class="mx-auto max-w-2xl px-4 py-12 md:px-8">
    <a href={backHref} class="font-mono text-[11px] font-bold text-mute hover:text-hotpink">&larr; {backLabel}</a>
    <p class="font-mono mt-6 text-[11px] font-bold text-hotpink">{eyebrow}</p>
    <h1 class="font-display reveal mt-2 text-4xl leading-[0.95] md:text-6xl">{title}</h1>
    <p class="font-mono mt-4 text-[11px] text-mute">{meta}</p>
    <div class="prose-ep mt-10">
      <slot />
    </div>
  </article>
</Base>

<style is:global>
  .prose-ep {
    color: var(--color-ink);
    line-height: 1.75;
  }
  .prose-ep p {
    margin-bottom: 1.25em;
  }
  .prose-ep h2 {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.01em;
    font-size: 1.5rem;
    margin: 2em 0 0.75em;
  }
  .prose-ep a {
    color: var(--color-hotpink);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .prose-ep ul,
  .prose-ep ol {
    margin: 0 0 1.25em 1.25em;
  }
  .prose-ep li {
    margin-bottom: 0.4em;
  }
  .prose-ep code {
    font-family: var(--font-mono);
    background: var(--color-gold);
    padding: 0.1em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
    border: 1.5px solid var(--color-ink);
  }
</style>
